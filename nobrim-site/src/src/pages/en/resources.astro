---
import BaseLayout from '../../layouts/BaseLayout.astro';
const resources = [
  ['Organizational Diagnosis Checklist', 'A practical guide to identify bottlenecks, priorities and improvement opportunities.', 'Use this checklist to prepare diagnostic conversations across people, processes, performance indicators and governance.', '/downloads/organizational-diagnosis-checklist-en.md'],
  ['Performance Indicators Guide', 'A structured starting point for actionable indicators.', 'Learn how to define owners, targets, review frequency and follow-up actions for the indicators that matter.', '/downloads/performance-indicators-guide-en.md'],
  ['Process Mapping Starter', 'A model for mapping process steps, owners, risks and outputs.', 'Document inputs, activities, responsibilities, controls and outputs before redesigning a process.', '/downloads/process-mapping-starter-en.md'],
];
---
<BaseLayout title="Resources" description="Practical Nobrim resources on management, processes and performance." lang="en">
  <section class="page-hero"><div class="container"><p class="eyebrow">Nobrim library</p><h1>Resources for better decisions</h1><p>Practical materials to support diagnostics, process improvement and management routines.</p></div></section>
  <section><div class="container grid">{resources.map(([title,summary,details,url]) => <article class="card resource-card"><h2>{title}</h2><p>{summary}</p><button class="btn-secondary open-resource" type="button" data-title={title} data-details={details} data-url={url}>View resource</button></article>)}</div></section>
  <dialog class="resource-dialog" aria-labelledby="resource-title" data-resource-dialog><button class="close" type="button" aria-label="Close" data-close>×</button><p class="eyebrow">Downloadable resource</p><h2 id="resource-title" data-title></h2><p data-details></p><a class="btn-primary" data-download download>Download resource</a></dialog>
</BaseLayout>
<script>
  const dialog = document.querySelector('[data-resource-dialog]');
  const title = dialog?.querySelector('[data-title]');
  const details = dialog?.querySelector('[data-details]');
  const download = dialog?.querySelector('[data-download]');
  document.querySelectorAll('.open-resource').forEach((button) => button.addEventListener('click', () => {
    if (!(button instanceof HTMLElement) || !(dialog instanceof HTMLDialogElement)) return;
    if (title) title.textContent = button.dataset.title || '';
    if (details) details.textContent = button.dataset.details || '';
    if (download instanceof HTMLAnchorElement) download.href = button.dataset.url || '#';
    dialog.showModal();
  }));
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => { if (dialog instanceof HTMLDialogElement) dialog.close(); });
  dialog?.addEventListener('click', (event) => { if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close(); });
</script>
<style>
  .page-hero { background: var(--bg-secondary); padding: var(--space-12) 0 var(--space-8); }.eyebrow { color: var(--accent-primary); font-size: var(--text-sm); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }.grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--space-5); }.resource-card { display:flex; flex-direction:column; align-items:flex-start; }.resource-card p { flex:1; }.resource-dialog { position:fixed; inset:0; width:min(92vw,640px); height:fit-content; max-height:calc(100dvh - 2rem); margin:auto; padding:var(--space-8); overflow-y:auto; border:0; border-radius:var(--radius-lg); box-shadow:var(--shadow-xl); }.resource-dialog::backdrop { background:rgba(0,26,58,.65); }.close { position:absolute; top:1rem; right:1rem; width:2.75rem; height:2.75rem; border:0; border-radius:50%; font-size:1.75rem; cursor:pointer; }@media(max-width:768px){.grid{grid-template-columns:1fr}.resource-dialog{padding:var(--space-6)}}
</style>
