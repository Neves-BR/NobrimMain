---
import Analytics from '@vercel/analytics/astro'
import '../styles/global.css';
import Header from '../components/Header.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'pt-BR' | 'en';
  schema?: Record<string, any>;
  ogType?: 'website' | 'article';
  ogImage?: string;
  robots?: string;
}

const { 
  title, 
  description, 
  lang = 'pt-BR', 
  schema,
  ogType = 'website',
  ogImage = '/og-image.png',
  robots = 'index,follow'
} = Astro.props;

const siteUrl = Astro.site;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const localeRoutes: Record<string, string> = {
  '/': '/en/', '/sobre': '/en/about', '/servicos': '/en/services', '/cases': '/en/cases',
  '/contato': '/en/contact', '/conteudos': '/en/resources', '/blog': '/en/blog', '/politica-de-privacidade': '/en/privacy',
  '/en': '/', '/en/about': '/sobre', '/en/services': '/servicos', '/en/cases': '/cases',
  '/en/contact': '/contato', '/en/resources': '/conteudos', '/en/blog': '/blog', '/en/privacy': '/politica-de-privacidade',
};
let alternatePath = localeRoutes[currentPath];
if (!alternatePath && currentPath.startsWith('/cases/')) {
  alternatePath = '/en/cases';
}
const alternateURL = alternatePath ? new URL(alternatePath, siteUrl) : undefined;
const portugueseURL = lang === 'pt-BR' ? canonicalURL : alternateURL;
const englishURL = lang === 'en' ? canonicalURL : alternateURL;

// Garante que a imagem do OG seja sempre uma URL absoluta
const imageURL = new URL(ogImage, canonicalURL).toString();
const ogLocale = lang === 'en' ? 'en_US' : 'pt_BR';
const safeSchema = schema
  ? JSON.stringify(schema).replace(/</g, '\\u003c')
  : undefined;
const pageTitle = title.includes('Nobrim') ? title : `${title} | Nobrim Soluções Corporativas`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    
    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />
    {portugueseURL && <link rel="alternate" hreflang="pt-BR" href={portugueseURL} />}
    {englishURL && <link rel="alternate" hreflang="en" href={englishURL} />}
    {portugueseURL && <link rel="alternate" hreflang="x-default" href={portugueseURL} />}
    
    <!-- Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap" />
    <link rel="dns-prefetch" href="https://nobrim.vercel.app" />
    
    <!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:secure_url" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Banner de visualização - ${title}`} />
    <meta property="og:site_name" content="Nobrim Soluções Corporativas" />
    <meta property="og:locale" content={ogLocale} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@nobrim" />
    <meta name="twitter:creator" content="@nobrim" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={`Banner de visualização - ${title}`} />
    
    <!-- Schema.org JSON-LD -->
    {safeSchema && (
      <script type="application/ld+json" set:html={safeSchema} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Pular para o conteÃºdo</a>
    <Header lang={lang} currentPath={Astro.url.pathname} />
    
    <main id="main-content" role="main">
      <slot />
      <!-- Botão flutuante do WhatsApp -->
      <WhatsAppFloat 
        phone="557192858821" 
        message="Olá! Vim pelo site da Nobrim e gostaria de mais informações."
        position="right"
      />
    </main>
    
    <!-- Componente de Footer será inserido aqui -->
    <Footer lang={lang} />
    <Analytics />
  </body>
</html>
