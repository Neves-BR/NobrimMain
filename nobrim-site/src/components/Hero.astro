---
interface Props {
  lang?: 'pt-BR' | 'en';
}

const { lang = 'pt-BR' } = Astro.props;
const isPt = lang === 'pt-BR';
---

<section class="hero-section">
  <div class="hero-container">
    <div class="hero-content">
      <span class="section-tag">{isPt ? 'Soluções Corporativas' : 'Corporate Solutions'}</span>
      <h1>{isPt ? 'Estratégia e Execução para o Próximo Nível do seu Negócio' : 'Strategy and Execution for the Next Level of Your Business'}</h1>
      <p>
        {isPt 
          ? 'Diagnosticamos gargalos operacionais e implementamos soluções de gestão que geram impacto direto na última linha do seu balanço. Desbloqueie o verdadeiro potencial da sua operação.'
          : 'We diagnose operational bottlenecks and implement management solutions that deliver direct impact on your bottom line. Unlock the true potential of your operation.'
        }
      </p>
      <div class="hero-actions">
        <a href={isPt ? '/contato' : '/en/contact'} class="btn-primary">
          {isPt ? 'Agendar Diagnóstico' : 'Schedule Assessment'}
        </a>
        <a href={isPt ? '/servicos' : '/en/services'} class="btn-secondary">
          {isPt ? 'Conhecer Soluções' : 'Explore Solutions'}
        </a>
      </div>
    </div>
    
    <div class="hero-image-wrapper">
      <img 
        src="/Hero.webp" 
        alt={isPt 
          ? "Equipe de consultores da Nobrim analisando painéis de performance em uma sala de reunião"
          : "Nobrim consulting team analyzing performance dashboards in a meeting room"
        } 
        width="600" 
        height="400"
        loading="eager"
        decoding="sync"
      />
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 80px 24px;
    background-color: var(--bg-primary);
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .section-tag {
    display: inline-block;
    background-color: var(--bg-secondary);
    color: var(--accent-primary);
    padding: 6px 12px;
    border-radius: 100px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 24px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--text-3xl);
    margin-bottom: 24px;
  }

  p {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 32px;
    max-width: 90%;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
  }

  .hero-image-wrapper img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-actions {
      justify-content: center;
    }
    p {
      max-width: 580px;
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }
    .hero-actions {
      flex-direction: column;
    }
  }
</style>
