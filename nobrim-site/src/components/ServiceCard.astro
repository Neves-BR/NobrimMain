---
interface Props {
  title: string;
  description: string;
  iconName?: string; // Para expandir depois com ícones reais
  linkUrl: string;
}

const { title, description, linkUrl } = Astro.props;
---

<article class="card service-card">
  <div class="icon-wrapper" aria-hidden="true">
    <!-- Placeholder para um ícone SVG da Nobrim -->
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
    </svg>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <a href={linkUrl} class="card-link" aria-label={`Saber mais sobre ${title}`}>
    Descobrir mais <span aria-hidden="true">&rarr;</span>
  </a>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .icon-wrapper {
    color: var(--accent-primary);
    margin-bottom: 16px;
  }
  h3 {
    margin-bottom: 12px;
    font-size: 1.25rem;
  }
  p {
    color: var(--text-secondary);
    margin-bottom: 24px;
    flex-grow: 1; /* Empurra o link para baixo */
  }
  .card-link {
    color: var(--accent-primary);
    font-weight: 600;
    text-decoration: none;
    align-self: flex-start;
  }
  .card-link:hover { text-decoration: underline; }
</style>