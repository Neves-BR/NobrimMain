---
---

<form action="/api/submit" method="POST" class="contact-form">
  <!-- Honeypot para evitar spam (invisível para usuários) -->
  <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

  <div class="form-group">
    <label-bg-dark for="name">Nome Completo</label-bg-dark>
    <input type="text" id="name" name="name" placeholder="Ex: Maria Silva" required />
  </div>

  <div class="form-group">
    <label-bg-dark for="company">Empresa</label-bg-dark>
    <input type="text" id="company" name="company" placeholder="Nome da sua organização" required />
  </div>

  <div class="form-group">
    <label-bg-dark for="email">E-mail Corporativo</label-bg-dark>
    <input type="email" id="email" name="email" placeholder="maria@empresa.com.br" required />
  </div>

  <div class="form-group">
    <label-bg-dark for="message">Como podemos ajudar?</label-bg-dark>
    <textarea id="message" name="message" rows="4" placeholder="Descreva brevemente o desafio ou cenário atual da sua operação..." required></textarea>
  </div>

  <button type="submit" class="btn-primary w-full">Solicitar Contato Especializado</button>
</form>

<style>
  .contact-form {
    background-color: var(--bg-primary-alt);
    padding: 32px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .form-group { margin-bottom: 20px; }
  label-bg-dark {
    display: block;
    font-weight: 500;
    margin-bottom: 8px;
    color: var(--text-primary);
  }
  input, textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    font-family: var(--font-primary);
    font-size: 1rem;
    background-color: var(--bg-primary);
    transition: border-color var(--transition-fast);
  }
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 2px rgba(255, 106, 0, 0.1);
  }
  .w-full {
    width: 100%;
    justify-content: center;
    margin-top: 8px;
  }
</style>
