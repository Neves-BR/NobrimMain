---
---

<form class="contact-form" data-contact-form>
  <input class="honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="form-group">
    <label for="name">Nome completo</label>
    <input type="text" id="name" name="name" autocomplete="name" required />
  </div>
  <div class="form-group">
    <label for="company">Empresa</label>
    <input type="text" id="company" name="company" autocomplete="organization" required />
  </div>
  <div class="form-group">
    <label for="email">E-mail corporativo</label>
    <input type="email" id="email" name="email" autocomplete="email" required />
  </div>
  <div class="form-group">
    <label for="message">Como podemos ajudar?</label>
    <textarea id="message" name="message" rows="4" required></textarea>
  </div>
  <p class="form-notice">Ao continuar, o WhatsApp da Nobrim será aberto para concluir o atendimento.</p>
  <p class="form-status" aria-live="polite"></p>
  <button type="submit" class="btn-primary w-full">Continuar para o WhatsApp</button>
  <button type="button" class="btn-email" data-email-contact>Prefiro enviar um e-mail</button>
</form>

<script is:inline>
  document.addEventListener('click', function (e) {
    var form = e.target.closest('[data-contact-form]');
    if (!form) return;

    var status = form.querySelector('.form-status');
    var isSubmit = e.target.matches('button[type="submit"], button[type="submit"] *');
    var isEmail = e.target.matches('[data-email-contact], [data-email-contact] *');

    if (!isSubmit && !isEmail) return;

    e.preventDefault();

    var name = form.querySelector('#name').value.trim();
    var company = form.querySelector('#company').value.trim();
    var email = form.querySelector('#email').value.trim();
    var messageText = form.querySelector('#message').value.trim();
    var honey = form.querySelector('.honeypot').value;

    if (honey) return;

    if (!name || !company || !email || !messageText) {
      if (status) {
        status.style.display = 'block';
        status.textContent = 'Por favor, preencha todos os campos do formulário.';
      }
      form.reportValidity();
      return;
    }

    if (isSubmit) {
      var text = [
        'Olá! Vim pelo site da Nobrim e gostaria de solicitar um contato especializado.',
        'Nome: ' + name,
        'Empresa: ' + company,
        'E-mail: ' + email,
        'Mensagem: ' + messageText
      ].join('\n');

      if (status) {
        status.style.display = 'block';
        status.textContent = 'Redirecionando para o WhatsApp…';
      }

      window.location.href = 'https://wa.me/557192858821?text=' + encodeURIComponent(text);
    }

    if (isEmail) {
      var body = [
        'Olá, gostaria de solicitar um contato especializado pela Nobrim.',
        '',
        'Nome: ' + name,
        'Empresa: ' + company,
        'E-mail: ' + email,
        'Mensagem: ' + messageText
      ].join('\n');

      if (status) {
        status.style.display = 'block';
        status.textContent = 'Abrindo seu cliente de e-mail…';
      }

      window.location.href = 'mailto:contato@nobrim.com.br?subject=' + encodeURIComponent('Contato pelo site Nobrim') + '&body=' + encodeURIComponent(body);
    }
  });
</script>

<style>
  .contact-form { background-color: var(--bg-primary-alt); padding: 32px; border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
  .form-group { margin-bottom: 20px; }
  label { color: var(--white); }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .w-full { width: 100%; justify-content: center; margin-top: 8px; }
  .btn-email { display: block; width: 100%; margin-top: 12px; padding: 0; border: 0; background: none; color: var(--white); cursor: pointer; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .btn-email:hover { color: var(--accent-primary); }
  .form-notice, .form-status { color: rgba(255, 255, 255, 0.78); font-size: 0.875rem; margin: 0 0 16px; }
  .form-status:empty { display: none; }
</style>
