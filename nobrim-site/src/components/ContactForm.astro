---
---
<form class="contact-form" data-contact-form>
  <input class="honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="form-group"><label for="name">Nome completo</label><input type="text" id="name" name="name" autocomplete="name" required /></div>
  <div class="form-group"><label for="company">Empresa</label><input type="text" id="company" name="company" autocomplete="organization" required /></div>
  <div class="form-group"><label for="email">E-mail corporativo</label><input type="email" id="email" name="email" autocomplete="email" required /></div>
  <div class="form-group"><label for="message">Como podemos ajudar?</label><textarea id="message" name="message" rows="4" required></textarea></div>
  <p class="form-notice">Ao continuar, o WhatsApp da Nobrim será aberto para concluir o atendimento.</p>
  <p class="form-status" aria-live="polite"></p>
  <button type="submit" class="btn-primary w-full" data-wa-submit>Continuar para o WhatsApp</button>
  <button type="button" class="btn-email" data-email-contact>Prefiro enviar um e-mail</button>
</form>

<script is:inline>
  (function () {
    'use strict';

    function getFormData(form) {
      const data = new FormData(form);
      if (data.get('_honey')) return null;
      if (!form.reportValidity()) return null;
      return data;
    }

    function redirectToWhatsApp(form) {
      const data = getFormData(form);
      if (!data) return;

      const status = form.querySelector('.form-status');
      if (status) status.textContent = 'Redirecionando para o WhatsApp…';

      const message = [
        'Olá! Vim pelo site da Nobrim e gostaria de solicitar um contato especializado.',
        `Nome: ${data.get('name')}`,
        `Empresa: ${data.get('company')}`,
        `E-mail: ${data.get('email')}`,
        `Mensagem: ${data.get('message')}`,
      ].join('\n');

      window.location.href = `https://wa.me/557192858821?text=${encodeURIComponent(message)}`;
    }

    function redirectToEmail(form) {
      const data = getFormData(form);
      if (!data) return;

      const status = form.querySelector('.form-status');
      if (status) status.textContent = 'Abrindo seu cliente de e-mail…';

      const body = [
        'Olá, gostaria de solicitar um contato especializado pela Nobrim.',
        '',
        `Nome: ${data.get('name')}`,
        `Empresa: ${data.get('company')}`,
        `E-mail: ${data.get('email')}`,
        `Mensagem: ${data.get('message')}`,
      ].join('\n');

      window.location.href = `mailto:contato@nobrim.com.br?subject=${encodeURIComponent('Contato pelo site Nobrim')}&body=${encodeURIComponent(body)}`;
    }

    function init() {
      const form = document.querySelector('[data-contact-form]');
      if (!form) return;

      // Camada 1: listener direto no form (mais confiável que document)
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        e.stopImmediatePropagation();
        redirectToWhatsApp(form);
      });

      // Camada 2: fallback no botão de submit (clique direto)
      const waBtn = form.querySelector('[data-wa-submit]');
      if (waBtn) {
        waBtn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopImmediatePropagation();
          redirectToWhatsApp(form);
        });
      }

      // E-mail
      const emailBtn = form.querySelector('[data-email-contact]');
      if (emailBtn) {
        emailBtn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopImmediatePropagation();
          redirectToEmail(form);
        });
      }
    }

    // Garante que o DOM está pronto
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  .contact-form { background-color: var(--bg-primary-alt); padding: 32px; border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
  .form-group { margin-bottom: 20px; }
  label { color: var(--white); }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .w-full { width: 100%; justify-content: center; margin-top: 8px; }
  .btn-email { display: block; width: 100%; margin-top: 12px; padding: 0; border: 0; background: none; color: var(--white); cursor: pointer; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .btn-email:hover { color: var(--accent-primary); }
  .form-notice, .form-status { color: rgba(255, 255, 255, 0.78); font-size: 0.875rem; margin: 0 0 16px; }
  .form-status:empty { display: none; }
</style>
