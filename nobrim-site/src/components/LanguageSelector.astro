---
interface Props { lang: 'pt-BR' | 'en'; currentPath: string; }
const { lang, currentPath } = Astro.props;
const isPt = lang === 'pt-BR';
const path = currentPath.replace(/\/$/, '') || '/';
const routes: Record<string, string> = {
  '/': '/en/', '/sobre': '/en/about', '/servicos': '/en/services', '/cases': '/en/cases',
  '/contato': '/en/contact', '/conteudos': '/en/resources', '/blog': '/en/blog', '/politica-de-privacidade': '/en/privacy',
  '/en': '/', '/en/about': '/sobre', '/en/services': '/servicos', '/en/cases': '/cases',
  '/en/contact': '/contato', '/en/resources': '/conteudos', '/en/blog': '/blog', '/en/privacy': '/politica-de-privacidade',
};
const alternative = routes[path] || (isPt ? '/en/' : '/');
const ptUrl = isPt ? path : alternative;
const enUrl = isPt ? alternative : path;
---

<div class="lang-selector" aria-label="Language selector">
  <a href={ptUrl} class={isPt ? 'active' : ''} hreflang="pt-BR" lang="pt-BR" aria-label="Mudar para português">PT</a>
  <span aria-hidden="true">|</span>
  <a href={enUrl} class={!isPt ? 'active' : ''} hreflang="en" lang="en" aria-label="Switch to English">EN</a>
</div>

<style>
  .lang-selector { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); font-weight: 700; letter-spacing: .05em; }
  .lang-selector a { padding: .35rem .5rem; color: rgba(255,255,255,.75); border-radius: var(--radius-sm); text-decoration: none; transition: color var(--transition-fast), background-color var(--transition-fast); }
  .lang-selector a:hover { color: var(--white); background: rgba(255,255,255,.1); text-decoration: none; }
  .lang-selector a.active { color: var(--accent-primary); background: rgba(255,106,0,.18); box-shadow: inset 0 0 0 1px rgba(255,106,0,.3); }
  .lang-selector span { color: rgba(255,255,255,.25); user-select: none; }
</style>
