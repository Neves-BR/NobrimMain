---
interface Props {
  clientName: string;
  industry: string;
  challenge: string;
  result: string;
  imageUrl: string;
  slug: string;
}

const { clientName, industry, challenge, result, imageUrl, slug } = Astro.props;
---

<article class="card case-card">
  <img src={imageUrl} alt={`Case de sucesso: ${clientName}`} width="400" height="225" loading="lazy" class="case-img" />
  <div class="case-content">
    <span class="industry-tag">{industry}</span>
    <h3>{clientName}</h3>
    <div class="case-details">
      <p><strong>Desafio:</strong> {challenge}</p>
      <p class="result-text"><strong>Impacto:</strong> {result}</p>
    </div>
    <a href={`/cases/${slug}`} class="btn-secondary case-btn">Ler Estudo Completo</a>
  </div>
</article>

<style>
  .case-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .case-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  .case-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .industry-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }
  h3 { margin-top: 0; margin-bottom: 16px; font-size: 1.5rem; }
  .case-details {
    margin-bottom: 24px;
    flex-grow: 1;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }
  .result-text { color: var(--text-primary); margin-top: 8px; }
  .case-btn { text-align: center; width: 100%; display: block; }
</style>