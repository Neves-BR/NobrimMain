---
import Analytics from '@vercel/analytics/astro'
<!--import '../styles/global.css';-->
import Header from '../components/Header.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'pt-BR' | 'en';
  schema?: Record<string, any>;
  ogType?: 'website' | 'article';
}

const { 
  title, 
  description, 
  lang = 'pt-BR', 
  schema,
  ogType = 'website'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.nobrim.com.br');
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Nobrim Soluções Corporativas</title>
    <meta name="description" content={description} />
    
    <!-- Canonical & Alternate Langs -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pt-BR" href="https://www.nobrim.com.br/" />
    <link rel="alternate" hreflang="en" href="https://www.nobrim.com.br/en/" />
    
    <!-- Preconnect & DNS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://nobrim.vercel.app" />
    
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Nobrim Soluções Corporativas" />
    <meta property="og:image" content="/assets/og-image.webp" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    
    <!-- Schema.org JSON-LD -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    
    <Header lang={lang} />
    
    <main id="main-content" role="main">
      <slot />
    <!-- Botão flutuante do WhatsApp -->
    <WhatsAppFloat 
      phone="557192858821" 
      message="Olá! Vim pelo site da Nobrim e gostaria de mais informações."
      position="right"
    />
    </main>
    
    <!-- Componente de Footer será inserido aqui -->
    <Footer lang={lang} />
    <Analytics />
  </body>
</html>
