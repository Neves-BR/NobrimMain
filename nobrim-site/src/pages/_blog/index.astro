---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { sanityClient } from '../../lib/sanity';

// Busca os posts em pt-BR
const query = `*[_type == "post" && language == "pt-BR"] | order(publishedAt desc) {
  _id,
  title,
  slug,
  excerpt,
  publishedAt
}`;

const posts = await sanityClient.fetch(query);

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog - Nobrim Soluções Corporativas",
  "url": "https://nobrim.vercel.app/blog",
  "description": "Artigos e insights sobre gestão empresarial, otimização de processos e governança."
};
---

<BaseLayout 
  title="Blog e Insights" 
  description="Acompanhe as últimas análises e tendências em gestão corporativa pela equipe de especialistas da Nobrim."
  lang="pt-BR"
  schema={blogSchema}
>
  <Header lang="pt-BR" />
  
  <main class="page-container py-20">
    <div class="container">
      <div class="text-center mb-12">
        <h1>Insights Estratégicos</h1>
        <p class="subtitle max-w-2xl mx-auto">
          Artigos, estudos de caso e tendências do mercado corporativo, escritos por quem vive a operação na prática.
        </p>
      </div>

      <div class="blog-grid">
        {posts.map((post) => (
          <article class="card blog-card">
            <div class="card-content">
              <time datetime={post.publishedAt} class="text-secondary text-sm font-semibold uppercase">
                {new Date(post.publishedAt).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
              </time>
              <h2 class="mt-2 text-xl">{post.title}</h2>
              <p class="mt-4 text-secondary">{post.excerpt}</p>
              <a href={`/blog/${post.slug.current}`} class="btn-secondary mt-6 inline-block">Ler Artigo</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .py-20 { padding: 80px 0; }
  .subtitle { font-size: 1.125rem; color: var(--text-secondary); margin-top: 16px; }
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 32px; }
  .blog-card { padding: 32px; display: flex; flex-direction: column; justify-content: space-between; }
  .mt-2 { margin-top: 8px; }
  .mt-4 { margin-top: 16px; }
  .mt-6 { margin-top: 24px; }
  .text-xl { font-size: 1.5rem; line-height: 1.3; }
  .text-sm { font-size: 0.875rem; }
</style>