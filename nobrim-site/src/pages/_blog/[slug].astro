---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { sanityClient } from '../../lib/sanity';
import { PortableText } from 'astro-portabletext';

// 1. Gera as rotas estáticas no momento do build
export async function getStaticPaths() {
  const query = `*[_type == "post" && language == "pt-BR"] {
    slug,
    title,
    author,
    publishedAt,
    excerpt,
    body
  }`;
  const posts = await sanityClient.fetch(query);

  return posts.map((post) => ({
    params: { slug: post.slug.current },
    props: { post },
  }));
}

const { post } = Astro.props;

// 2. Schema.org do Artigo
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "datePublished": post.publishedAt,
  "author": {
    "@type": "Person",
    "name": post.author || "Equipe Nobrim"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Nobrim Soluções Corporativas",
    "logo": {
      "@type": "ImageObject",
      "url": "https://nobrim.vercel.app/assets/logo-placeholder.webp"
    }
  }
};
---

<BaseLayout 
  title={post.title} 
  description={post.excerpt}
  lang="pt-BR"
  schema={articleSchema}
  ogType="article"
>
  <Header lang="pt-BR" />
  
  <main class="page-container py-20">
    <article class="post-container">
      <header class="post-header text-center mb-12">
        <time datetime={post.publishedAt} class="text-secondary font-semibold uppercase tracking-wider">
          {new Date(post.publishedAt).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
        </time>
        <h1 class="mt-4">{post.title}</h1>
        <p class="author mt-4 text-secondary">Por: <strong>{post.author}</strong></p>
      </header>

      <div class="post-content">
        <!-- Renderiza o conteúdo rico do Sanity -->
        <PortableText value={post.body} />
      </div>
      
      <div class="post-footer mt-12 text-center">
        <a href="/blog" class="btn-secondary">&larr; Voltar para o Blog</a>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .py-20 { padding: 80px 24px; }
  .post-container { max-width: 800px; margin: 0 auto; }
  .post-header h1 { font-size: 2.5rem; margin-bottom: 16px; }
  .mt-4 { margin-top: 16px; }
  .mt-12 { margin-top: 48px; }
  .mb-12 { margin-bottom: 48px; }
  
  /* Estilos para o conteúdo gerado pelo PortableText */
  .post-content {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--text-primary);
  }
  .post-content :global(h2), .post-content :global(h3) {
    margin-top: 2em;
    margin-bottom: 0.75em;
    font-family: var(--font-display);
  }
  .post-content :global(p) { margin-bottom: 1.5em; }
  .post-content :global(ul) { margin-bottom: 1.5em; padding-left: 24px; }
  .post-content :global(li) { margin-bottom: 0.5em; }
</style>