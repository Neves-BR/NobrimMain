---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LogosMarquee from '../components/LogosMarquee.astro';

// Schema.org para a Home (Organization, WebSite e FAQPage para AEO/AIO)
const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.nobrim.com.br/#organization",
      "name": "Nobrim Soluções Corporativas",
      "url": "https://www.nobrim.com.br",
      "logo": "https://www.nobrim.com.br/logo-nobrim.webp",
      "description": "Consultoria empresarial brasileira especializada em diagnóstico organizacional, gestão da qualidade, otimização de processos e gestão de performance.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Francisco Drumond, 41, Centro",
        "addressLocality": "Camaçari",
        "addressRegion": "BA",
        "postalCode": "42800-970",
        "addressCountry": "BR"
      },
      "founder": {
        "@type": "Person",
        "name": "Jozelia Silva",
        "jobTitle": "Fundadora e CEO"
      },
      "knowsAbout": [
        "Gestão da Qualidade",
        "ISO 9001",
        "Boas Práticas de Fabricação (BPF)",
        "Business Process Management (BPM)",
        "PDCA",
        "5W2H",
        "Lean Manufacturing",
        "Gestão de Performance",
        "OKRs e KPIs"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+55-71-9285-8821",
        "contactType": "customer service",
        "email": "contato@nobrim.com.br",
        "availableLanguage": ["Portuguese", "English"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.nobrim.com.br/#website",
      "url": "https://www.nobrim.com.br",
      "name": "Nobrim Soluções Corporativas",
      "publisher": {
        "@id": "https://www.nobrim.com.br/#organization"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O que é o Diagnóstico Nobrim 360º e como ele ajuda minha empresa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O Diagnóstico Nobrim 360º realiza uma análise integrada dos processos, controles, indicadores e práticas de gestão da sua empresa. O objetivo é identificar riscos, gargalos operacionais e oportunidades de melhoria, estabelecendo prioridades claras para orientar as próximas decisões estratégicas."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona o Mapeamento e Padronização de Processos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mapeamos o fluxo atual das atividades e elaboramos fluxogramas, procedimentos operacionais e instruções de trabalho práticas. Isso garante maior consistência na execução, reduz falhas e facilita o treinamento e a integração de novos colaboradores."
          }
        },
        {
          "@type": "Question",
          "name": "Quais metodologias são aplicadas na Melhoria Contínua e Planos de Ação?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Investigamos a causa-raiz dos problemas e estruturamos planos de ação eficientes utilizando ferramentas consolidadas como PDCA, 5W2H, Diagrama de Ishikawa e 5 Porquês, garantindo o acompanhamento de prazos, responsabilidades e a eficácia das soluções."
          }
        },
        {
          "@type": "Question",
          "name": "Como a Nobrim atua na Gestão da Qualidade e Indicadores?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Estruturamos rotinas, controles e indicadores de desempenho (KPIs) alinhados aos requisitos da norma ISO 9001 e das Boas Práticas de Fabricação (BPF). Isso apoia decisões baseadas em dados, fortalece a melhoria contínua e assegura conformidade em auditorias."
          }
        },
        {
          "@type": "Question",
          "name": "Como são realizados os treinamentos e capacitações corporativas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desenvolvemos capacitações totalmente personalizadas para preparar a sua equipe para a execução de processos padronizados, fortalecendo o engajamento, a conformidade diária e a cultura de excelência operacional na empresa."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title="Consultoria Estratégica e Gestão" 
  description="A Nobrim transforma a complexidade do seu negócio em resultados mensuráveis através de consultoria especializada em gestão e processos."
  lang="pt-BR"
  schema={homeSchema}
>
  <!-- 1. Hero Section -->
  <Hero lang="pt-BR" />

  <!-- 2. Social Proof (Logos Marquee) -->
  <LogosMarquee lang="pt-BR" />

  <!-- 3. Serviços Overview (Placeholder da estrutura) -->
  <section class="services-section bg-secondary py-20">
    <div class="container">
      <div class="section-header text-center mb-12">
        <h2>Áreas de Atuação</h2>
        <h4>Expertise direcionada para os desafios mais críticos da sua empresa.</h4>
      </div>
      
      <div class="services-grid">
        <!-- Exemplo de Card de Serviço direto no HTML para validação rápida -->
        <div class="card">
          <h3>Diagnóstico Organizacional</h3>
          <p>Mapeamento completo da sua estrutura atual para identificar ineficiências, sobreposições de funções e oportunidades de corte de custos operacionais.</p>
          <a href="/servicos" class="text-accent mt-4 inline-block font-semibold">Saiba mais &rarr;</a>
        </div>
        <div class="card">
          <h3>Gestão de Performance</h3>
          <p>Implementação de OKRs e KPIs estratégicos, garantindo que todos os níveis da empresa estejam alinhados aos objetivos de longo prazo da diretoria.</p>
          <a href="/servicos" class="text-accent mt-4 inline-block font-semibold">Saiba mais &rarr;</a>
        </div>
        <div class="card">
          <h3>Transformação de Processos</h3>
          <p>Redesenho de fluxos de trabalho (BPM) para aumentar a agilidade produtiva e garantir a padronização e escalabilidade do modelo de negócio.</p>
          <a href="/servicos" class="text-accent mt-4 inline-block font-semibold">Saiba mais &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. CTA Final -->
  <section class="cta-section py-20 text-center">
    <div class="container">
      <h2>Pronto para otimizar sua operação?</h2>
      <p class="mb-8 max-w-2xl mx-auto">Fale com um de nossos especialistas e descubra como a Nobrim pode estruturar um plano de ação sob medida para a sua realidade.</p>
      <a href="/contato" class="btn-primary">Solicitar Contato Comercial</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Classes utilitárias rápidas para a Home */
  .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .text-center { text-align: center; }
  .py-20 { padding-top: 80px; padding-bottom: 80px; }
  .mb-6 { margin-bottom: 24px; }
  .mb-8 { margin-bottom: 32px; }
  .mb-12 { margin-bottom: 48px; }
  .mt-4 { margin-top: 16px; }
  .max-w-2xl { max-width: 42rem; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .text-secondary { color: var(--text-secondary); }
  .text-accent { color: var(--accent-primary); }
  .font-semibold { font-weight: 600; }
  .uppercase { text-transform: uppercase; }
  .tracking-wider { letter-spacing: 0.05em; }
  .bg-secondary { background-color: var(--bg-secondary); }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 24px;
    justify-content: center;
  }

  .card {
    text-align: center;
  }

  .card h3,
  .card p {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .section-header h2,
  .cta-section h2,
  .cta-section p {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
</style>
