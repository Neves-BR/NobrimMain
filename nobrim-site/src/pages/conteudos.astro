---
import BaseLayout from '../layouts/BaseLayout.astro';

const contents = [
  {
    title: 'Checklist de Diagnóstico Organizacional',
    summary: 'Um roteiro objetivo para identificar gargalos, prioridades e oportunidades de melhoria.',
    details: 'Use este checklist na preparação de reuniões de diagnóstico. Ele organiza perguntas sobre pessoas, processos, indicadores e governança para tornar a análise inicial mais objetiva.',
    downloadUrl: '/downloads/checklist-diagnostico-organizacional.md',
  },
  {
    title: 'Guia prático de Indicadores',
    summary: 'Princípios para transformar metas estratégicas em indicadores acionáveis.',
    details: 'O guia apresenta uma estrutura simples para escolher indicadores, definir responsáveis, frequência de acompanhamento e ações corretivas.',
    downloadUrl: '/downloads/guia-indicadores-de-performance.md',
  },
  {
    title: 'Mapa inicial de Processos',
    summary: 'Modelo de partida para mapear fluxos e localizar desperdícios operacionais.',
    details: 'Um material de apoio para documentar entradas, etapas, responsáveis, riscos e saídas de um processo antes de iniciar o redesenho.',
    downloadUrl: '/downloads/mapa-inicial-de-processos.md',
  },
];
---

<BaseLayout title="Conteúdos" description="Materiais práticos da Nobrim sobre gestão, processos e performance." lang="pt-BR">
  <section class="content-hero">
    <div class="container">
      <p class="eyebrow">Biblioteca Nobrim</p>
      <h1>Conteúdos para aplicar no seu negócio</h1>
      <p>Materiais práticos para apoiar diagnósticos, decisões e a evolução da gestão da sua empresa.</p>
    </div>
  </section>

  <section class="content-list" aria-label="Materiais para download">
    <div class="container cards">
      {contents.map((content) => (
        <article class="card download-card">
          <h2>{content.title}</h2>
          <p>{content.summary}</p>
          <button
            class="btn-secondary open-modal"
            type="button"
            data-title={content.title}
            data-details={content.details}
            data-download-url={content.downloadUrl}
          >
            Ver conteúdo
          </button>
        </article>
      ))}
    </div>
  </section>

  <dialog class="content-dialog" aria-labelledby="modal-title" data-content-modal>
    <button class="close-modal" type="button" aria-label="Fechar" data-close-modal>×</button>
    <p class="eyebrow">Material para download</p>
    <h2 id="modal-title" data-modal-title></h2>
    <p data-modal-details></p>
    <a class="btn-primary" data-modal-download download>Baixar conteúdo</a>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector('[data-content-modal]');
  const title = dialog?.querySelector('[data-modal-title]');
  const details = dialog?.querySelector('[data-modal-details]');
  const download = dialog?.querySelector('[data-modal-download]');
  document.querySelectorAll('.open-modal').forEach((button) => {
    button.addEventListener('click', () => {
      if (!(button instanceof HTMLElement) || !(dialog instanceof HTMLDialogElement)) return;
      if (title) title.textContent = button.dataset.title || '';
      if (details) details.textContent = button.dataset.details || '';
      if (download instanceof HTMLAnchorElement) download.href = button.dataset.downloadUrl || '#';
      dialog.showModal();
    });
  });
  dialog?.querySelector('[data-close-modal]')?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.close();
  });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
  });
</script>

<style>
  .content-hero { padding: var(--space-12) 0 var(--space-8); background: var(--bg-secondary); }
  .content-hero p:not(.eyebrow) { font-size: var(--text-md); color: var(--text-secondary); }
  .eyebrow { color: var(--accent-primary); font-size: var(--text-sm); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .content-list { padding: var(--space-10) 0; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .download-card { display: flex; flex-direction: column; align-items: flex-start; }
  .download-card p { flex: 1; }
  .content-dialog { width: min(92vw, 640px); padding: var(--space-8); border: 0; border-radius: var(--radius-lg); box-shadow: var(--shadow-xl); }
  .content-dialog::backdrop { background: rgba(0, 26, 58, .65); }
  .content-dialog h2 { padding-right: 2rem; }
  .close-modal { position: absolute; top: 1rem; right: 1rem; width: 2.75rem; height: 2.75rem; border: 0; border-radius: 50%; background: var(--bg-secondary); color: var(--text-primary); cursor: pointer; font-size: 1.75rem; }
  @media (max-width: 900px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .cards { grid-template-columns: 1fr; } .content-dialog { padding: var(--space-6); } }
</style>
