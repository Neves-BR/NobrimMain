---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Blog" description="Conteúdos e insights da Nobrim." lang="pt-BR" robots="noindex,follow">
  <section class="blog-placeholder">
    <div class="container">
      <h1>Insights em breve</h1>
      <p>Estamos preparando conteúdos sobre gestão, processos e performance. Enquanto isso, conheça nossos materiais práticos na página de conteúdos.</p>
      <a href="/conteudos" class="btn-primary">Ver conteúdos</a>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-placeholder { padding: var(--space-12) 0; text-align: center; }
  .blog-placeholder p { margin-inline: auto; }
</style>
