---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const { clientName, industry, challenge, result, imageUrl } = item.data;

// Schema de Breadcrumb e Article para SEO & Google AI Overviews
const caseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.nobrim.com.br/" },
        { "@type": "ListItem", "position": 2, "name": "Cases de Sucesso", "item": "https://www.nobrim.com.br/cases" },
        { "@type": "ListItem", "position": 3, "name": clientName, "item": `https://www.nobrim.com.br/cases/${item.id}` }
      ]
    },
    {
      "@type": "Article",
      "headline": `${clientName} — Case de Sucesso em Consulting e Processos`,
      "description": challenge,
      "articleSection": industry,
      "inLanguage": "pt-BR",
      "publisher": {
        "@type": "Organization",
        "name": "Nobrim Soluções Corporativas",
        "url": "https://www.nobrim.com.br"
      },
      "author": {
        "@type": "Organization",
        "name": "Nobrim Soluções Corporativas"
      }
    }
  ]
};
---

<BaseLayout 
  title={`${clientName} | Case de Sucesso - Nobrim`} 
  description={challenge}
  lang="pt-BR"
  schema={caseSchema}
>
  <div class="case-detail-page py-16 bg-secondary">
    <div class="container">
      
      <!-- Navegação / Voltar -->
      <nav class="mb-8">
        <a href="/cases" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Voltar para Cases de Sucesso
        </a>
      </nav>

      <!-- Cartão Principal do Artigo -->
      <article class="case-card-container">
        
        <!-- Cabeçalho / Hero -->
        <header class="case-header">
          <div class="badge-tag">{industry}</div>
          <h1 class="case-title">{clientName}</h1>
          
          <!-- Destaques Rápidos (Desafio x Resultado) -->
          <div class="highlights-grid">
            <div class="highlight-item challenge">
              <h3>O Desafio</h3>
              <p>{challenge}</p>
            </div>
            <div class="highlight-item result">
              <h3>Resultado Alcançado</h3>
              <p>{result}</p>
            </div>
          </div>
        </header>

        <!-- Imagem do Case -->
        {imageUrl && (
          <div class="case-featured-image">
            <img src={imageUrl} alt={`Case de sucesso - ${clientName}`} />
          </div>
        )}

        <!-- Corpo do Texto (Markdown Renderizado) -->
        <div class="case-body content-typography">
          <Content />
        </div>

        <!-- Footer do Case / CTA -->
        <footer class="case-footer">
          <h3>Quer alcançar resultados semelhantes na sua empresa?</h3>
          <p>Fale com nossos especialistas e descubra como nossa metodologia pode otimizar sua operação.</p>
          <a href="/contato" class="btn-primary">Agendar um Diagnóstico</a>
        </footer>

      </article>

    </div>
  </div>
</BaseLayout>

<style>
  /* Layout do Container Central */
  .container {
    width: 100%;
    max-width: 960px; /* Largura otimizada para leitura confortável */
    margin: 0 auto;
    padding: 0 24px;
  }

  .py-16 {
    padding-top: 64px;
    padding-bottom: 64px;
  }

  /* Link de voltar */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary, #64748b);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-primary, #0f172a);
  }

  /* Container / Card Principal */
  .case-card-container {
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.06);
    overflow: hidden;
    padding: 48px;
  }

  /* Header do Case */
  .badge-tag {
    display: inline-block;
    padding: 6px 14px;
    background-color: var(--badge-bg, #e2e8f0);
    color: var(--badge-color, #334155);
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 20px;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case-title {
    font-size: 2.5rem;
    line-height: 1.2;
    font-weight: 700;
    color: var(--text-primary, #0f172a);
    margin-bottom: 32px;
  }

  /* Grid de Desafio e Resultado */
  .highlights-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 40px;
  }

  .highlight-item {
    padding: 20px;
    border-radius: 12px;
    border-left: 4px solid;
  }

  .highlight-item.challenge {
    background-color: #f8fafc;
    border-color: #94a3b8;
  }

  .highlight-item.result {
    background-color: #f0fdf4;
    border-color: #22c55e;
  }

  .highlight-item h3 {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
    color: #475569;
  }

  .highlight-item p {
    font-size: 1rem;
    line-height: 1.5;
    color: #1e293b;
    margin: 0;
  }

  /* Imagem em Destaque */
  .case-featured-image {
    width: 60%;
    max-height: 420px;
    border-radius: 12px;
    overflow: hidden;
    margin: 0 auto 48px auto; /* Centraliza horizontalmente e mantém a margem inferior */
  }

  .case-featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Estilização da Tipografia do Texto (Markdown Renderizado) */
  .content-typography {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #334155;
    max-width: 720px; /* Mantém largura de linha ideal para leitura de parágrafos */
    margin: 0 auto 48px auto;
  }

  .content-typography :global(h2) {
    font-size: 1.75rem;
    font-weight: 700;
    color: #0f172a;
    margin-top: 40px;
    margin-bottom: 16px;
  }

  .content-typography :global(h3) {
    font-size: 1.35rem;
    font-weight: 600;
    color: #1e293b;
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .content-typography :global(p) {
    margin-bottom: 24px;
  }

  .content-typography :global(ul), 
  .content-typography :global(ol) {
    margin-bottom: 24px;
    padding-left: 24px;
  }

  .content-typography :global(li) {
    margin-bottom: 8px;
  }

  .content-typography :global(blockquote) {
    border-left: 4px solid var(--color-primary, #2563eb);
    padding-left: 20px;
    margin: 32px 0;
    font-style: italic;
    color: #475569;
  }
  /* Estilização e Responsividade para Tabelas dentro do Markdown */
  .content-typography :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 32px 0;
    font-size: 1rem;
    text-align: left;
    display: block;
    overflow-x: auto; /* Permite rolagem horizontal suave no celular */
    white-space: nowrap;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
  }

  @media (min-width: 640px) {
    .content-typography :global(table) {
      display: table; /* Volta ao comportamento normal de tabela em telas maiores */
      white-space: normal;
    }
  }

  .content-typography :global(th) {
    background-color: #f8fafc;
    color: #0f172a;
    font-weight: 600;
    padding: 12px 16px;
    border-bottom: 2px solid #e2e8f0;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
  }

  .content-typography :global(td) {
    padding: 14px 16px;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
  }

  /* Efeito zebrado nas linhas para facilitar a leitura */
  .content-typography :global(tr:nth-child(even)) {
    background-color: #f8fafc;
  }

  .content-typography :global(tr:hover) {
    background-color: #f1f5f9;
  }
  /* Footer com CTA de Conversão */
  .case-footer {
    background-color: #f8fafc;
    border-radius: 12px;
    padding: 36px;
    text-align: center;
    border: 1px solid #e2e8f0;
  }

  .case-footer h3 {
    font-size: 1.35rem;
    color: #0f172a;
    margin-bottom: 8px;
  }

  .case-footer p {
    color: #64748b;
    margin-bottom: 24px;
  }

  .btn-primary {
    display: inline-block;
    padding: 12px 28px;
    background-color: var(--btn-primary-bg, #0f172a);
    color: #ffffff;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  /* Responsividade */
  @media (max-width: 768px) {
    .case-card-container {
      padding: 24px;
    }

    .case-title {
      font-size: 1.85rem;
    }

    .highlights-grid {
      grid-template-columns: 1fr;
    }

    .content-typography {
      font-size: 1rem;
    }
  }
  @media (max-width: 768px) {
    .case-card-container {
      padding: 24px;
    }

    .case-title {
      font-size: 1.85rem;
    }

    .highlights-grid {
      grid-template-columns: 1fr;
    }

    .content-typography {
      font-size: 1rem;
    }

    /* Ocupa mais espaço em telas pequenas sem perder o alinhamento */
    .case-featured-image {
      width: 100%;
    }
  }
</style>
