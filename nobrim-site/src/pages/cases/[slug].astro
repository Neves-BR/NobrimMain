---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  
  return cases.map((item) => ({
    params: { slug: item.id }, // Usa item.id em vez de item.slug
    props: { item },
  }));
}

const { item } = Astro.props;

// No Astro v5+, o método de renderização da coleção é importado de 'astro:content'
const { Content } = await render(item);
const { clientName, industry, challenge, result, imageUrl } = item.data;
---

<BaseLayout title={`${clientName} | Case de Sucesso`} description={challenge}>
  <article class="container py-20">
    <header class="mb-8">
      <span class="badge">{industry}</span>
      <h1>{clientName}</h1>
    </header>

    <div class="case-meta">
      <p><strong>Desafio:</strong> {challenge}</p>
      <p><strong>Resultado:</strong> {result}</p>
    </div>

    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>
