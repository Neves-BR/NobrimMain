---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Consultoria em Gestão da Qualidade e Processos",
  "provider": {
    "@type": "Organization",
    "name": "Nobrim Soluções Corporativas"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Serviços de Consultoria B2B",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Gestão da Qualidade" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Padronização de Processos" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Melhoria de Processos" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Capacitação & Treinamentos" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Diagnóstico Empresarial" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Auditoria e Conformidade" } }
    ]
  }
};
---

<BaseLayout 
  title="Nossos Serviços" 
  description="Soluções práticas em Gestão da Qualidade, Padronização, Melhoria de Processos e Diagnóstico Empresarial."
  lang="pt-BR"
  schema={servicesSchema}
>
  
  <main class="page-container py-20">
    <div class="container">
      <div class="text-center mb-12">
        <h1>Áreas de Especialidade</h1>
        <p class="subtitle">
          Transformamos conhecimento técnico em <strong>soluções práticas e aplicáveis</strong>, ajudando sua empresa a estruturar processos, capacitar equipes e construir uma cultura de <strong>melhoria contínua</strong>.
        </p>
      </div>

      <div class="grid-3">
        <ServiceCard 
          title="Gestão da Qualidade" 
          description="Implantação e estruturação de rotinas da qualidade focadas em eficiência, com embasamento em diretrizes da **ISO 9001** e **Boas Práticas de Fabricação (BPF)**." 
          linkUrl="/contato" 
        />
        <ServiceCard 
          title="Padronização de Processos" 
          description="Mapeamento e elaboração de **fluxogramas e documentações práticas**, garantindo consistência operacional, redução de erros e facilidade no treinamento da equipe." 
          linkUrl="/contato" 
        />
        <ServiceCard 
          title="Melhoria de Processos" 
          description="Aplicação de metodologias consolidadas como **PDCA, 5W2H, Ishikawa e 5 Porquês** para eliminar gargalos e otimizar a rotina operacional." 
          linkUrl="/contato" 
        />
        <ServiceCard 
          title="Capacitação & Treinamentos" 
          description="Desenvolvimento e preparação de equipes para a execução de **processos bem definidos**, fortalecendo o engajamento e a cultura de excelência." 
          linkUrl="/contato" 
        />
        <ServiceCard 
          title="Diagnóstico Empresarial" 
          description="Análise detalhada do cenário atual do seu negócio para **identificar oportunidades de melhoria**, gargalos produtivos e pontos de ajuste estrutural." 
          linkUrl="/contato" 
        />
        <ServiceCard 
          title="Auditoria & Indicadores" 
          description="Acompanhamento sistemático através de **análise de indicadores de desempenho** e auditorias internas para garantir conformidade e tomada de decisão embasada." 
          linkUrl="/contato" 
        />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* Centralização do container principal */
  .container {
    width: 100%;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  .text-center {
    text-align: center;
  }

  .mb-12 {
    margin-bottom: 48px;
  }

  .py-20 { 
    padding: 80px 0; 
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 672px; /* Limita a largura do parágrafo */
    margin: 16px auto 0 auto; /* O "auto" nas laterais é o que força a centralização do bloco */
    text-align: center;
  }

  .grid-3 { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
    gap: 32px; 
  }
</style>
