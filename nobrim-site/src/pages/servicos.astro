---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';

const servicesSchema = {
  {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "serviceType": "Consultoria em Gestão da Qualidade, Processos e Performance",
      "provider": {
        "@type": "Organization",
        "name": "Nobrim Soluções Corporativas",
        "url": "https://www.nobrim.com.br"
      },
      "areaServed": "BR",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Serviços de Consultoria Empresarial B2B",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Diagnóstico Nobrim 360º" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mapeamento e Padronização de Processos" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Melhoria Contínua e Planos de Ação" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Gestão da Qualidade e Indicadores (ISO 9001, BPF)" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Capacitação e Treinamentos Personalizados" } }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O que é o Diagnóstico Nobrim 360º e como ele ajuda minha empresa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O Diagnóstico Nobrim 360º realiza uma análise integrada dos processos, controles, indicadores e práticas de gestão da sua empresa. O objetivo é identificar riscos, gargalos operacionais e oportunidades de melhoria, estabelecendo prioridades claras para orientar as próximas decisões estratégicas."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona o Mapeamento e Padronização de Processos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mapeamos o fluxo atual das atividades e elaboramos fluxogramas, procedimentos operacionais e instruções de trabalho práticas. Isso garante maior consistência na execução, reduz falhas e facilita o treinamento e a integração de novos colaboradores."
          }
        },
        {
          "@type": "Question",
          "name": "Quais metodologias são aplicadas na Melhoria Contínua e Planos de Ação?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Investigamos a causa-raiz dos problemas e estruturamos planos de ação eficientes utilizando ferramentas consolidadas como PDCA, 5W2H, Diagrama de Ishikawa e 5 Porquês, garantindo o acompanhamento de prazos, responsabilidades e a eficácia das soluções."
          }
        },
        {
          "@type": "Question",
          "name": "Como a Nobrim atua na Gestão da Qualidade e Indicadores?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Estruturamos rotinas, controles e indicadores de desempenho (KPIs) alinhados aos requisitos da norma ISO 9001 e das Boas Práticas de Fabricação (BPF). Isso apoia decisões baseadas em dados, fortalece a melhoria contínua e assegura conformidade em auditorias."
          }
        },
        {
          "@type": "Question",
          "name": "Como são realizados os treinamentos e capacitações corporativas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Desenvolvemos capacitações totalmente personalizadas para preparar a sua equipe para a execução de processos padronizados, fortalecendo o engajamento, a conformidade diária e a cultura de excelência operacional na empresa."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout 
  title="Nossos Serviços" 
  description="Soluções práticas em Gestão da Qualidade, Padronização, Melhoria de Processos e Diagnóstico Empresarial."
  lang="pt-BR"
  schema={servicesSchema}
>
  
  <div class="page-container py-20">
    <div class="container">
      <div class="text-center mb-12">
        <h1>Áreas de Especialidade</h1>
        <p class="subtitle">
          Transformamos conhecimento técnico em <strong>soluções práticas e aplicáveis</strong>, ajudando sua empresa a estruturar processos, capacitar equipes e construir uma cultura de <strong>melhoria contínua</strong>.
        </p>
      </div>

     <div class="grid-3">
        <ServiceCard 
          title="Diagnóstico Nobrim 360º" 
          description="Análise integrada de processos, controles e práticas de gestão para <strong>identificar gargalos e prioridades estratégicas</strong>, direcionando as melhores tomadas de decisão para o seu negócio." 
          linkUrl="/contato" 
        />
      
        <ServiceCard 
          title="Mapeamento e Padronização de Processos" 
          description="Elaboração de <strong>fluxogramas, procedimentos e instruções de trabalho práticas</strong> para eliminar erros, otimizar rotinas e garantir consistência operacional na execução e treinamento da equipe." 
          linkUrl="/contato" 
        />
      
        <ServiceCard 
          title="Melhoria Contínua e Planos de Ação" 
          description="Investigação de causas-raiz e aplicação de metodologias como <strong>PDCA, 5W2H, Ishikawa e 5 Porquês</strong> para estruturar ações eficientes, garantindo o acompanhamento de prazos e resultados." 
          linkUrl="/contato" 
        />
      
        <ServiceCard 
          title="Gestão da Qualidade e Indicadores" 
          description="Estruturação de rotinas, controles e KPIs para decisões baseadas em dados e melhoria contínua, com foco nos requisitos da <strong>ISO 9001 e Boas Práticas de Fabricação (BPF)</strong>." 
          linkUrl="/contato" 
        />
      
        <ServiceCard 
          title="Capacitação e Treinamentos Personalizados" 
          description="Desenvolvimento e preparação de equipes para a execução de <strong>processos padronizados</strong>, fortalecendo o engajamento, a conformidade e a cultura de excelência operacional." 
          linkUrl="/contato" 
        />
      </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Centralização do container principal */
  .container {
    width: 100%;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  .text-center {
    text-align: center;
  }

  .mb-12 {
    margin-bottom: 48px;
  }

  .py-20 { 
    padding: 80px 0; 
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 672px;
    margin: 16px auto 0 auto;
    text-align: center;
  }

  .grid-3 { 
    display: grid; 
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); 
    gap: 32px; 
  }
</style>
