---
import BaseLayout from '../../layouts/BaseLayout.astro';
const services=['Quality Management','Process Standardization','Process Improvement','Training and Capability Building','Business Diagnosis','Audits and Performance Indicators'];
---
<BaseLayout title="Our services" description="Practical solutions in quality management, standardization and process improvement." lang="en"><section><div class="container"><h1>Areas of expertise</h1><p>We turn technical knowledge into practical, applicable solutions that help businesses structure processes, build capable teams and create a culture of continuous improvement.</p><div class="grid">{services.map((service)=><article class="card"><h2>{service}</h2><p>Tailored consulting to create clarity, consistency and measurable improvement.</p><a href="/en/contact">Talk to us</a></article>)}</div></div></section></BaseLayout><style>.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-5)}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.grid{grid-template-columns:1fr}}</style>
