---
import BaseLayout from '../../layouts/BaseLayout.astro';
const services=['Quality Management','Process Standardization','Process Improvement','Training and Capability Building','Business Diagnosis','Audits and Performance Indicators'];
---
<BaseLayout title="Our services" description="Practical solutions in quality management, standardization and process improvement." lang="en">
  <section class="py-20"><div class="container"><div class="text-center mb-12"><h1>Areas of expertise</h1><p class="subtitle">We turn technical knowledge into practical, applicable solutions that help businesses structure processes, build capable teams and create a culture of continuous improvement.</p></div><div class="grid">{services.map((service)=><article class="card"><h2>{service}</h2><p>Tailored consulting to create clarity, consistency and measurable improvement.</p><a href="/en/contact">Talk to us</a></article>)}</div></div></section>
</BaseLayout>
<style>.py-20{padding:80px 0}.text-center{text-align:center}.mb-12{margin-bottom:48px}.subtitle{font-size:1.125rem;color:var(--text-secondary);max-width:672px;margin:16px auto 0 auto;text-align:center}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-5)}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.grid{grid-template-columns:1fr}}</style>
