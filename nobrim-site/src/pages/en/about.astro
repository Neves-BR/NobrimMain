---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="About us" description="Learn about Nobrim's purpose and leadership." lang="en">
  <section class="intro-hero text-center"><div class="container narrow"><h1>Practical structure for sustainable growth</h1><p class="subtitle">Nobrim turns technical knowledge into actionable solutions for processes, teams and more consistent decisions.</p></div></section>
  <section><div class="container narrow"><h2>Our purpose</h2><p>Well-designed processes, capable people and decisions based on information make companies more efficient and ready to grow.</p><h2>Leadership</h2><img src="/sobre-img/CEO.png" alt="Nobrim founder and CEO" width="600" height="400" loading="lazy" /><h3>Jozelia Silva</h3><p>Founder and CEO, with more than 11 years of experience in corporate and industrial environments, quality assurance, audits and process improvement.</p></div></section>
</BaseLayout>
<style>.intro-hero{background:var(--bg-secondary);padding:var(--space-12) 0 var(--space-8);text-align:center}.narrow{max-width:800px;margin-inline:auto}.subtitle{max-width:680px;margin:16px auto 0 auto;text-align:center;color:var(--text-secondary)}.narrow img{border-radius:var(--radius-lg)}</style>
