---
import BaseLayout from '../../layouts/BaseLayout.astro';
const resources=[['Organizational Diagnosis Checklist','A practical guide to identify bottlenecks, priorities and improvement opportunities.','/downloads/checklist-diagnostico-organizacional.md'],['Performance Indicators Guide','A structured starting point for actionable indicators.','/downloads/guia-indicadores-de-performance.md'],['Process Mapping Starter','A model for mapping process steps, owners, risks and outputs.','/downloads/mapa-inicial-de-processos.md']];
---
<BaseLayout title="Resources" description="Practical Nobrim resources on management, processes and performance." lang="en"><section><div class="container"><h1>Resources for better decisions</h1><p>Practical materials to support diagnostics, process improvement and management routines.</p><div class="grid">{resources.map(([title,description,url])=><article class="card"><h2>{title}</h2><p>{description}</p><a class="btn-primary" href={url} download>Download</a></article>)}</div></div></section></BaseLayout><style>.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-5)}@media(max-width:768px){.grid{grid-template-columns:1fr}}</style>
