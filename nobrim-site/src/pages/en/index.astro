---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Strategic Consulting and Management" description="Nobrim turns business complexity into measurable results through consulting in management and processes." lang="en">
  <section class="hero text-center"><div class="container narrow"><p class="eyebrow">Corporate solutions</p><h1>Strategy and execution for your business to move forward</h1><p class="subtitle">We diagnose operational bottlenecks and implement management solutions that deliver measurable impact.</p><div class="actions"><a class="btn-primary" href="/en/contact">Schedule a consultation</a><a class="btn-secondary" href="/en/services">Explore services</a></div></div></section>
  <section><div class="container"><h2>Areas of expertise</h2><div class="grid"><article class="card"><h3>Quality Management</h3><p>Structured routines that make quality practical and consistent.</p></article><article class="card"><h3>Process Improvement</h3><p>Mapping and redesign to reduce waste, errors and delays.</p></article><article class="card"><h3>Business Diagnosis</h3><p>A clear view of priorities, risks and improvement opportunities.</p></article></div></div></section>
</BaseLayout>
<style>.hero{padding:var(--space-12) 0;background:var(--bg-secondary);text-align:center}.narrow{max-width:800px;margin-inline:auto}.eyebrow{color:var(--accent-primary);font-weight:700;text-transform:uppercase}.subtitle{max-width:680px;margin:16px auto 32px auto;text-align:center;color:var(--text-secondary)}.actions{display:flex;gap:1rem;flex-wrap:wrap;justify-content:center}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-5)}@media(max-width:768px){.grid{grid-template-columns:1fr}}</style>
