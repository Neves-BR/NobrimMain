---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  mainEntity: {
    '@type': 'Organization',
    name: 'Nobrim Soluções Corporativas',
    url: 'https://www.nobrim.com.br/sobre',
    description: 'Consultoria estratégica em gestão da qualidade, padronização e melhoria de processos.',
    founder: {
      '@type': 'Person',
      name: 'Jozelia Silva',
      jobTitle: 'Fundadora e CEO',
      description: 'Mais de 11 anos de experiência em ambientes corporativos e industriais com foco em auditorias internas, padronização, garantia da qualidade e indicadores.',
      knowsAbout: ['ISO 14001', 'ISO 22716', 'ISO 45001', 'ISO 9001', 'BPF', 'PDCA', '5W2H', 'Ishikawa', '5 Porquês', 'Auditoria da Qualidade']
    }
  },
};
---

<BaseLayout title="Sobre nós" description="Conheça a história e a liderança da Nobrim Soluções Corporativas." lang="pt-BR" schema={schema}>
  <section class="intro text-center">
    <div class="container narrow">
      <p class="eyebrow">Sobre a Nobrim</p>
      <h1>Estrutura para empresas crescerem com clareza</h1>
      <p>A Nobrim transforma conhecimento técnico em soluções práticas para processos, equipes e decisões mais consistentes.</p>
    </div>
  </section>

  <section>
    <div class="container split">
      <div>
        <h2>Propósito e atuação</h2>
        <p>Na NOBRIM, acreditamos que qualidade não precisa ser complexa. Processos claros, pessoas preparadas e decisões orientadas por dados tornam as empresas mais eficientes, competitivas e preparadas para crescer de forma sustentável.</p>
        <ul>
          <li>Diagnóstico empresarial e identificação de oportunidades.</li>
          <li>Gestão da qualidade e padronização de processos.</li>
          <li>Melhoria contínua, redução de gargalos e desperdícios.</li>
          <li>Capacitação de equipes para aplicação prática das ferramentas de qualidade.</li>
        </ul>
      </div>
      <img src="/sobre-img/CEO.png" alt="Fundadora e CEO da Nobrim" width="420" height="599" loading="lazy" class="profile-image" />
    </div>
  </section>

  <section class="leadership">
    <div class="container narrow center">
      <h2>Nossa liderança</h2>
      <h3>Jozelia Silva</h3>
      <p class="role">Fundadora e CEO</p>
      <p>Com mais de 11 anos de experiência em ambientes corporativos e industriais, Jozelia atua com auditorias, padronização, garantia da qualidade e indicadores. Sua experiência abrange PDCA, 5W2H, Ishikawa, 5 Porquês e normas como ISO 9001 e Boas Práticas de Fabricação.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding: var(--space-12) 0 var(--space-8); background: var(--bg-secondary); }
  .intro p { margin-inline: auto; text-align: center; }
  .narrow { max-width: 780px; }
  .eyebrow, .role { color: var(--accent-primary); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: center; }
  .profile-image { width: 100%; max-height: 750px; object-fit: cover; border-radius: var(--radius-lg); }
  .leadership { background: var(--bg-secondary); }
  .center { text-align: center; }
  .center p { margin-inline: auto; text-align: center; }
  @media (max-width: 768px) { .split { grid-template-columns: 1fr; } }
</style>
