---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CaseCard from '../components/CaseCard.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://nobrim.vercel.app/" },
    { "@type": "ListItem", "position": 2, "name": "Cases de Sucesso", "item": "https://nobrim.vercel.app/cases" }
  ]
};
---

<BaseLayout 
  title="Cases de Sucesso" 
  description="Veja como a metodologia da Nobrim gerou resultados reais e otimizou a operação de grandes empresas."
  lang="pt-BR"
  schema={breadcrumbSchema}
>
  <Header lang="pt-BR" />
  
  <main class="page-container py-20 bg-secondary">
    <div class="container">
      <div class="text-center mb-12">
        <h1>Histórias de Transformação</h1>
        <p class="subtitle max-w-2xl mx-auto">
          Resultados comprovados na prática. Conheça nossos projetos mais recentes e o impacto direto que geramos no negócio de nossos clientes.
        </p>
      </div>

      <div class="grid-2">
        <CaseCard 
          clientName="Indústria Vektor" 
          industry="Manufatura" 
          challenge="Altos custos de produção devido a ineficiências no chão de fábrica e falta de padronização." 
          result="Redução de 18% nos custos operacionais em 6 meses através da implantação de Lean Manufacturing." 
          imageUrl="/assets/case-1-placeholder.webp" 
          slug="industria-vektor" 
        />
        <CaseCard 
          clientName="Agro Logística Sul" 
          industry="Operações e Logística" 
          challenge="Falta de visibilidade na cadeia de suprimentos e altos custos de frete no transporte de matéria-prima das fazendas." 
          result="Otimização das rotas de escoamento e implantação de controles sistêmicos, reduzindo o tempo de trânsito em 22%." 
          imageUrl="/assets/case-2-placeholder.webp" 
          slug="agro-logistica-sul" 
        />
        <CaseCard 
          clientName="TechSolve S.A." 
          industry="Tecnologia B2B" 
          challenge="Crescimento desordenado causando atrito entre as áreas de Vendas e CS (Customer Success)." 
          result="Redesenho da jornada do cliente e alinhamento de KPIs (SLA), aumentando a retenção de clientes em 35%." 
          imageUrl="/assets/case-3-placeholder.webp" 
          slug="techsolve-sa" 
        />
        <CaseCard 
          clientName="Grupo Varejista Alfa" 
          industry="Varejo" 
          challenge="Excesso de estoque descentralizado e rupturas nas gôndolas das principais filiais." 
          result="Centralização do S&OP (Planejamento de Vendas e Operações), diminuindo o capital de giro retido em R$ 4 milhões." 
          imageUrl="/assets/case-4-placeholder.webp" 
          slug="grupo-varejista-alfa" 
        />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .py-20 { padding: 80px 0; }
  .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 32px; }
  .subtitle { font-size: 1.125rem; color: var(--text-secondary); margin-top: 16px; }
  @media (max-width: 768px) { .grid-2 { grid-template-columns: 1fr; } }
</style>